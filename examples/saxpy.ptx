// y[i] = alpha * x[i] + y[i]   (the classic BLAS "saxpy")
.version 7.8
.target sm_80
.address_size 64

.visible .entry saxpy(
    .param .u32 n,
    .param .f32 alpha,
    .param .u64 x,
    .param .u64 y
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<5>;
    .reg .f32   %f<5>;
    .reg .b64   %rd<8>;

    ld.param.u32        %r1, [n];
    ld.param.f32        %f1, [alpha];
    ld.param.u64        %rd1, [x];
    ld.param.u64        %rd2, [y];
    mov.u32             %r2, %ctaid.x;
    mov.u32             %r3, %ntid.x;
    mov.u32             %r4, %tid.x;
    mad.lo.s32          %r2, %r2, %r3, %r4;
    setp.ge.s32         %p1, %r2, %r1;
    @%p1 bra            EXIT;

    cvta.to.global.u64  %rd3, %rd1;
    cvta.to.global.u64  %rd4, %rd2;
    mul.wide.s32        %rd5, %r2, 4;
    add.s64             %rd6, %rd3, %rd5;
    add.s64             %rd7, %rd4, %rd5;
    ld.global.f32       %f2, [%rd6];
    ld.global.f32       %f3, [%rd7];
    fma.rn.f32          %f4, %f1, %f2, %f3;     // single rounding: alpha*x + y
    st.global.f32       [%rd7], %f4;
EXIT:
    ret;
}
