// Each thread sums n consecutive floats: out[tid] = sum(in[tid*n .. tid*n+n-1]).
// Contains a loop, so liveness has to flow around the back edge.
.version 7.8
.target sm_80
.address_size 64

.visible .entry row_sum(
    .param .u64 in,
    .param .u64 out,
    .param .u32 n
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<5>;
    .reg .f32   %f<3>;
    .reg .b64   %rd<8>;

    ld.param.u64        %rd1, [in];
    ld.param.u64        %rd2, [out];
    ld.param.u32        %r1, [n];
    cvta.to.global.u64  %rd3, %rd1;
    cvta.to.global.u64  %rd4, %rd2;
    mov.u32             %r2, %tid.x;
    mul.lo.s32          %r3, %r2, %r1;
    mul.wide.s32        %rd5, %r3, 4;
    add.s64             %rd6, %rd3, %rd5;       // pointer to the first element
    mov.f32             %f1, 0f00000000;        // acc = 0.0f
    mov.u32             %r4, 0;                 // k = 0
    setp.eq.s32         %p1, %r1, 0;
    @%p1 bra            STORE;
LOOP:
    ld.global.f32       %f2, [%rd6];
    add.f32             %f1, %f1, %f2;
    add.s64             %rd6, %rd6, 4;
    add.s32             %r4, %r4, 1;
    setp.lt.u32         %p1, %r4, %r1;
    @%p1 bra            LOOP;
STORE:
    mul.wide.u32        %rd7, %r2, 4;
    add.s64             %rd7, %rd4, %rd7;
    st.global.f32       [%rd7], %f1;
    ret;
}
