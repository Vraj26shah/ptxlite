// Shows the optimizer at work. Compare:
//   ptxlite examples/const_fold.ptx -O0 --emit=opt-ptx
//   ptxlite examples/const_fold.ptx -O1 --emit=opt-ptx
// %r1..%r5 are compile-time constants (folded to 280), and %r8/%r9 are never
// stored, so they are deleted.
.version 7.8
.target sm_80
.address_size 64

.visible .entry fold_demo(
    .param .u64 out
)
{
    .reg .b32   %r<10>;
    .reg .b64   %rd<4>;

    ld.param.u64        %rd1, [out];
    cvta.to.global.u64  %rd2, %rd1;
    mov.u32             %r1, 16;
    mov.u32             %r2, 4;
    mul.lo.u32          %r3, %r1, %r2;      // 64
    add.u32             %r4, %r3, 6;        // 70
    shl.b32             %r5, %r4, 2;        // 280
    mov.u32             %r6, %tid.x;
    add.u32             %r7, %r6, %r5;      // tid + 280
    sub.u32             %r8, %r1, %r2;      // dead: never used
    xor.b32             %r9, %r8, 255;      // dead: never used
    mul.wide.u32        %rd3, %r6, 4;
    add.s64             %rd3, %rd2, %rd3;
    st.global.u32       [%rd3], %r7;
    ret;
}
